[Unit]
Description=T300 local-only display server
After=systemd-user-sessions.service systemd-logind.service
Wants=systemd-logind.service
Conflicts=getty@tty7.service
ConditionPathExists=/etc/t300/commissioning/host-validated
ConditionPathExists=/dev/tty0

[Service]
Type=simple
User=root
Group=t300-display
RuntimeDirectory=t300/xorg
RuntimeDirectoryMode=0750
WorkingDirectory=/opt/t300/control
Environment=PYTHONPATH=/opt/t300/control
ExecCondition=+/opt/t300/venvs/control/bin/python /opt/t300/control/bin/t300-candidate.py check-service-gate host
ExecStartPre=/opt/t300/venvs/control/bin/python -m t300_mainline.display_auth
ExecStart=/usr/lib/xorg/Xorg :0 -config /etc/t300/xorg/xorg.conf -auth /run/t300/xorg/Xauthority -nolisten tcp -noreset -keeptty vt7 -logfile /run/t300/xorg/Xorg.0.log
Restart=on-failure
RestartSec=3
MemoryMax=256M
CPUWeight=20
IOWeight=20
TasksMax=64
LimitNOFILE=256
LimitFSIZE=16777216
OOMScoreAdjust=400
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty7
UtmpMode=user
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/etc/t300
ReadWritePaths=/run/t300/xorg /tmp/.X11-unix
DevicePolicy=closed
DeviceAllow=/dev/tty0 rw
DeviceAllow=/dev/tty7 rw
DeviceAllow=/dev/fb0 rw
DeviceAllow=/dev/dri/card0 rw
DeviceAllow=/dev/dri/renderD128 rw
DeviceAllow=char-input r
UMask=0027

[Install]
WantedBy=multi-user.target
