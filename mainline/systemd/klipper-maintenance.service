[Unit]
Description=T300 local-only Klipper maintenance mode
Conflicts=klipper.service moonraker.service
Before=klipper.service moonraker.service
BindsTo=t300-host-mcu.service
After=t300-host-mcu.service
ConditionPathExists=/etc/t300/commissioning/maintenance-enabled

[Service]
Type=simple
User=klipper
Group=t300-comms
SupplementaryGroups=t300-gcode dialout tty
RuntimeDirectory=t300-maintenance
RuntimeDirectoryMode=0750
ExecStartPre=+/opt/t300/venvs/control/bin/python /opt/t300/control/bin/t300-candidate.py consume-maintenance-marker
ExecStart=/opt/t300/venvs/klipper/bin/python /opt/t300/src/klipper/klippy/klippy.py /etc/t300/maintenance/printer.cfg -I /run/t300-maintenance/klippy.serial -l /var/log/t300/klipper-maintenance/klippy.log
Restart=no
TimeoutStopSec=15
MemoryHigh=384M
MemoryMax=512M
CPUWeight=1000
IOWeight=1000
TasksMax=64
LimitNOFILE=512
LimitFSIZE=33554432
OOMScoreAdjust=-500
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
DeviceAllow=char-pts rw
ReadOnlyPaths=/etc/t300 /var/lib/t300/moonraker-data/gcodes
ReadWritePaths=/run/t300-maintenance /var/log/t300/klipper-maintenance
UMask=0027

# Intentionally no [Install] section. Maintenance is started explicitly after
# the laptop deployment tool creates its one-use root-owned marker.
