[Unit]
Description=T300 KlipperScreen local UI
After=t300-xorg.service moonraker.service
Requires=t300-xorg.service
ConditionPathExists=/etc/t300/commissioning/host-validated

[Service]
Type=simple
User=klipperscreen
Group=klipperscreen
SupplementaryGroups=t300-display
Environment=HOME=/var/lib/t300/klipperscreen
Environment=DISPLAY=:0
Environment=XAUTHORITY=/run/t300/xorg/Xauthority
Environment=GDK_BACKEND=x11
Environment=XDG_RUNTIME_DIR=/run/t300/klipperscreen
WorkingDirectory=/opt/t300/src/klipperscreen
RuntimeDirectory=t300/klipperscreen
RuntimeDirectoryMode=0700
ExecCondition=+/opt/t300/venvs/control/bin/python /opt/t300/control/bin/t300-candidate.py check-service-gate host
ExecStart=/opt/t300/venvs/klipperscreen/bin/python /opt/t300/src/klipperscreen/screen.py -c /etc/t300/klipperscreen/KlipperScreen.conf -l /var/log/t300/klipperscreen/KlipperScreen.log
Restart=on-failure
RestartSec=5
MemoryHigh=256M
MemoryMax=384M
CPUWeight=50
IOWeight=50
TasksMax=128
LimitNOFILE=512
LimitFSIZE=16777216
OOMScoreAdjust=300
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/etc/t300
ReadWritePaths=/run/t300 /var/log/t300/klipperscreen /var/lib/t300/klipperscreen
UMask=0027

[Install]
WantedBy=multi-user.target
