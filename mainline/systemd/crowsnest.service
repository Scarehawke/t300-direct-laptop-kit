[Unit]
Description=T300 Crowsnest camera service
After=network.target
ConditionPathExists=/etc/t300/commissioning/host-validated

[Service]
Type=simple
User=crowsnest
Group=crowsnest
SupplementaryGroups=video
ExecCondition=+/opt/t300/venvs/control/bin/python /opt/t300/control/bin/t300-candidate.py check-service-gate host
WorkingDirectory=/opt/t300/src/crowsnest
ExecStart=/opt/t300/venvs/crowsnest/bin/python -m crowsnest -c /etc/t300/crowsnest/crowsnest.conf -l /var/log/t300/crowsnest/crowsnest.log
Restart=on-failure
RestartSec=5
MemoryMax=256M
CPUWeight=10
IOWeight=10
TasksMax=64
LimitNOFILE=256
LimitFSIZE=16777216
OOMScoreAdjust=600
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
DevicePolicy=closed
DeviceAllow=char-video4linux rw
ReadOnlyPaths=/etc/t300
ReadWritePaths=/run/t300 /var/log/t300/crowsnest
UMask=0027

[Install]
WantedBy=multi-user.target
