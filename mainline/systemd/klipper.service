[Unit]
Description=T300 Klipper motion host
Conflicts=klipper-maintenance.service
After=var-lib-t300-moonraker\x2ddata-gcodes.mount
ConditionPathExists=/etc/t300/commissioning/production-enabled
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=klipper
Group=t300-comms
SupplementaryGroups=t300-gcode dialout
RuntimeDirectory=t300/klipper
RuntimeDirectoryMode=0750
ExecCondition=+/opt/t300/venvs/control/bin/python /opt/t300/control/bin/t300-candidate.py check-service-gate production
ExecStart=/opt/t300/venvs/klipper/bin/python /opt/t300/src/klipper/klippy/klippy.py /etc/t300/klipper/printer.cfg -I /run/t300/klipper/klippy.serial -a /run/t300/klipper/klippy.sock -l /var/log/t300/klipper/klippy.log
Restart=no
TimeoutStopSec=15
MemoryHigh=384M
MemoryMax=512M
CPUWeight=1000
IOWeight=1000
TasksMax=64
LimitNOFILE=512
LimitFSIZE=33554432
OOMScoreAdjust=-500
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/etc/t300 /var/lib/t300/gcode-approvals /var/lib/t300/approved-gcodes
ReadWritePaths=/run/t300/klipper /var/log/t300/klipper
UMask=0007

[Install]
WantedBy=multi-user.target
